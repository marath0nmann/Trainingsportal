# favicon.ico → dynamisches favicon.php umleiten
RedirectMatch 302 ^/favicon\.ico$ /favicon.php?size=32

# index.html nie cachen – damit neue JS/CSS-Versionen sofort greifen
<Files "index.html">
  Header set Cache-Control "no-cache, must-revalidate"
  Header set Pragma "no-cache"
</Files>

# JS und CSS lange cachen (werden über ?vNNN versioniert)
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
